# Copy to .env.local and fill in. Every value is optional: without them the app
# runs on demo data.

# Public YouTube search (Outliers, Channel research).
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=

# "Connect YouTube" sign-in (Feed stats and Optimize use your own channel).
# Same project → also enable "YouTube Analytics API" → Credentials →
# Create OAuth client ID → Web application →
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the session cookie. At least 32 random characters, e.g.:
#   openssl rand -base64 32
SESSION_SECRET=

# AI Coach (Google Gemini, free tier). Get a key at https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.5-flash-lite. gemini-3.8-flash is also free and smarter.
GEMINI_MODEL=

# Public base URL of the app (used to build the OAuth redirect URI).
APP_URL=http://localhost:3000
